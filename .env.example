# Скопіюй цей файл у .env і заповни своїми значеннями.
# .env не комітиться в git.

# Brevo → SMTP & API → API Keys → Create a new API key
BREVO_API_KEY=

# Brevo → Senders & IP → Senders: адреса, яку Brevo дозволяє відправляти
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SteamSite

# Необов'язково. Потрібно, якщо сайт відкривається не з того хоста,
# на який прийшов запит (наприклад, за проксі). Без цього береться хост запиту.
# PUBLIC_BASE_URL=https://your-site.vercel.app
